# Copy to .devcontainer/.env (gitignored) and fill in. Sourced by bash through
# load-env.sh in every terminal and OpenCode task, so an edit is live in the
# next terminal — no rebuild. Bash syntax: KEY=value with no spaces around `=`;
# quote a value that contains spaces or `#`. These are the names opencode.jsonc
# reads via {env:…}; check-env.sh prints SET/MISSING per name, never a value.
BRAVE_API_KEY=
CONTEXT7_API_KEY=
GITHUB_MCP_PAT=
LYCEUM_API_KEY=
META_API_KEY=